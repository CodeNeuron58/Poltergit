# All integrations are optional. Never commit .env.
POLTERGIT_OLLAMA_URL=http://127.0.0.1:11434
POLTERGIT_MODEL=gemma4:e4b
POLTERGIT_EMBEDDING_MODEL=embeddinggemma
# Tiger Cloud free service or local PostgreSQL with pgvector:
POLTERGIT_DATABASE_URL=
# Sentry Developer project DSN (metadata only; source/prompts not sent):
POLTERGIT_SENTRY_DSN=
# GitHub retrieval is opt-in. Public repositories work without a token.
POLTERGIT_GITHUB=false
POLTERGIT_GITHUB_TOKEN=
POLTERGIT_KOKORO_MODEL=models/kokoro-v1.0.onnx
POLTERGIT_KOKORO_VOICES=models/voices-v1.0.bin
POLTERGIT_VOICE=af_heart
